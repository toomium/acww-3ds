-#if !HOST_FRONTEND_SDL && !HOST_FRONTEND_NONE
+#if !HOST_FRONTEND_SDL && !HOST_FRONTEND_NONE && !HOST_FRONTEND_3DS
 
 #define _GNU_SOURCE
 #include <fcntl.h>
diff --git a/modern/host/plat.h b/modern/host/plat.h
index 99851ba2..40d60eba 100644
--- a/modern/host/plat.h
+++ b/modern/host/plat.h
@@ -10,10 +10,20 @@
 #include <stdint.h>
 #include <time.h>
 
+// ---- called first in main: what the platform sets up before anything else (the 3DS: the options from a file,
+// the log); nothing elsewhere
+void host_plat_init(void);
+
 // ---- time
 uint64_t host_plat_time_ns(void);           // a monotonic clock in nanoseconds (any epoch)
 void host_plat_sleep_until_ns(uint64_t t);  // sleep until host_plat_time_ns() >= t
 void host_plat_sleep_ms(unsigned ms);
+uint64_t host_plat_ticks(void);  // the 3DS's system tick (268 MHz) as it is, no conversion; only plat_3ds.c has it
+// the 3DS's CPU counters (plat_3ds.c only): counting two events from now (0 if they can't be reached); stopped and
+// read: the cycles and the two events' counts
+int host_plat_pmu_start(int event0, int event1);
+void host_plat_pmu_stop(uint32_t count[3]);
+void host_plat_log_write(void);  // (the 3DS port: the log's lines buffered so far to the SD card)
 // the local (wall-clock) time now, broken down as localtime_r would; 0 if it isn't known
 int host_plat_localtime(struct tm *out);
 
@@ -23,6 +33,10 @@ void host_plat_restart(char **argv);
 
 // ---- threads: a detached background thread (the watchdog); 0 if it couldn't be started
 int host_plat_thread_start(void (*fn)(void *), void *arg);
+// a thread that runs while the game's thread is busy (ACWW_FPS's sampler): on another core, or where there is only
+// one, at a higher priority; 0 if it couldn't be started. core1 (the 3DS; elsewhere ignored): 1 the system core
+// (core 1) tried first, before the New 3DS's core 2; 2 the game's core at once
+int host_plat_sampler_start(void (*fn)(void *), void *arg, int core1);
 
 // ---- memory
 // A stack of n bytes (rounded up to whole pages) for a coroutine (coro.h), with an inaccessible guard page below it
diff --git a/modern/host/plat_posix.c b/modern/host/plat_posix.c
index b629667f..d6b2310e 100644
--- a/modern/host/plat_posix.c
+++ b/modern/host/plat_posix.c
@@ -16,6 +16,8 @@
 
 #include "plat.h"
 
+void host_plat_init(void) {}
+
 uint64_t host_plat_time_ns(void) {
     struct timespec t;
     clock_gettime(CLOCK_MONOTONIC, &t);
@@ -78,6 +80,9 @@ int host_plat_thread_start(void (*fn)(void *), void *arg) {
     return 1;
 }
 
+// (the system shares the cores between threads by itself)
+int host_plat_sampler_start(void (*fn)(void *), void *arg, int core1) { (void)core1; return host_plat_thread_start(fn, arg); }
+
 static size_t page_size(void) {
     static size_t page;
     if (!page) page = (size_t)sysconf(_SC_PAGESIZE);
