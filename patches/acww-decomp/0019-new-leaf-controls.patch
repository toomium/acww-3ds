From: acww-3ds <noreply@invalid>
Subject: [PATCH] Player and menus: "New Leaf controls" (option ACWW_NL_CONTROLS)

The 3DS port's option "New Leaf controls" (options_cfg.c, port_options.h): Y picks up items and pulls weeds (B on
the DS), so B only runs; X opens the pockets (Y on the DS) and closes them again, also from the pocket menu's tab
(PocketMenu::handleTabSwitch, where X switched to the map); the map has no key then. Off, the keys are the DS's.
---
 src/main/unk_02004558_extra.cpp  |  8 ++++++++
 src/main/unk_0206e54c.cpp        | 12 ++++++++++++
 src/ov096/unk_02294c40.cpp       |  8 ++++++++
 src/ov099/unk_ov099_02294c40.cpp |  7 +++++++
 src/ov103/unk_ov103_02294c40.cpp |  7 +++++++
 5 files changed, 42 insertions(+)

diff --git a/src/main/unk_02004558_extra.cpp b/src/main/unk_02004558_extra.cpp
index f4550db..c518a99 100644
--- a/src/main/unk_02004558_extra.cpp
+++ b/src/main/unk_02004558_extra.cpp
@@ -2,6 +2,9 @@
 // The 14 functions of the translation unit 0x02004558-0x0201106c that only mwcc 1.2/base compiles
 // to the original code (see unk_02004558.cpp; same declarations, nothing else is defined here).
 #include "types.h"
+#ifdef ENHANCED_PORT
+#include "port_options.h"
+#endif
 #ifdef HOST
 #include "host_input.h"
 #endif
@@ -913,7 +916,12 @@ void PlayerActor::readInput() {
                 v10 = 1;
             } else {
                 v10 = 0;
+#ifdef ENHANCED_PORT
+                // B on the DS, Y with "New Leaf controls" (port_options.h): picking up, pulling weeds
+                if (gPad.trig & port_key_pick_up()) {
+#else
                 if (gPad.trig & 2) {
+#endif
                     v14 = 1;
                     PlayerActor_OffsetByAngle(&r5c, this, &this->position, &this->rotY, &data_020d5e48);
                 }
diff --git a/src/main/unk_0206e54c.cpp b/src/main/unk_0206e54c.cpp
index 732fade..af24c8c 100644
--- a/src/main/unk_0206e54c.cpp
+++ b/src/main/unk_0206e54c.cpp
@@ -1,5 +1,8 @@
 #include "uptr.h"
 #include "types.h"
+#ifdef ENHANCED_PORT
+#include "port_options.h"
+#endif
 #include "menu/MenuProc.h"
 #include "sys/ListNode.h"
 #include "Unk_020d8c7c.h"
@@ -228,13 +231,22 @@ BOOL MenuManager::onExecute() {
             MenuCtrl_SetButtons();
             return TRUE;
         }
+#ifdef ENHANCED_PORT
+        // the pockets: Y on the DS, X with "New Leaf controls" (port_options.h), which leaves the map without a key
+        if (k & port_key_pockets()) {
+#else
         if (k & 0x800) {
+#endif
             TalkRequest_AddMenu(0);
             sMenuMode = 0;
             MenuCtrl_SetButtons();
             return TRUE;
         }
+#ifdef ENHANCED_PORT
+        if (!port_new_leaf_controls() && Hud_GetSceneHudKind() != 2 && (gPad[1] & 0x400)) {
+#else
         if (Hud_GetSceneHudKind() != 2 && (gPad[1] & 0x400)) {
+#endif
             TalkRequest_AddMenu(0);
             sMenuMode = 5;
             MenuCtrl_SetButtons();
diff --git a/src/ov096/unk_02294c40.cpp b/src/ov096/unk_02294c40.cpp
index 1c5d602..0d424b2 100644
--- a/src/ov096/unk_02294c40.cpp
+++ b/src/ov096/unk_02294c40.cpp
@@ -345,9 +345,17 @@ BOOL PocketMenu::handleTabSwitch() {
         t = MenuTabBar_HitTestTouch();
     } else {
         u16 v = gPad[1];
+#ifdef ENHANCED_PORT
+        // the key that opened the pockets closes them: Y on the DS, X with "New Leaf controls" (port_options.h),
+        // where the map has no key (X on the DS)
+        if (v & port_key_pockets()) {
+            t = 7;
+        } else if (!port_new_leaf_controls() && (v & 0x400)) {
+#else
         if (v & 0x800) {
             t = 7;
         } else if (v & 0x400) {
+#endif
             t = 5;
         } else if (v & 4) {
             t = 4;
diff --git a/src/ov099/unk_ov099_02294c40.cpp b/src/ov099/unk_ov099_02294c40.cpp
index 835def6..2f46321 100644
--- a/src/ov099/unk_ov099_02294c40.cpp
+++ b/src/ov099/unk_ov099_02294c40.cpp
@@ -1,5 +1,8 @@
 // ov099: scene overlay (class PocketMenuUnk, vtable 0x02296b00, 0x2794 bytes).
 #include "types.h"
+#ifdef ENHANCED_PORT
+#include "port_options.h"
+#endif
 #include "host_shared_calls.h"
 #include "Unk_020d8c7c.h"
 #include "ui/CursorMotion.h"
@@ -332,7 +335,11 @@ void PocketMenuUnk::mainAct04() {
             }
         }
     } else {
+#ifdef ENHANCED_PORT
+        if ((gPad[1] & port_key_pockets()) != 0) {  // (the key that opened the pockets, port_options.h)
+#else
         if ((gPad[1] & 0x800) != 0) {
+#endif
             transitionState = 3;
             setPhase(1);
             nameBalloon.hide(1);
