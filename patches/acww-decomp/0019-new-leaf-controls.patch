+#endif
 #include "host_shared_calls.h"
 #include "Unk_020d8c7c.h"
 #include "ui/CursorMotion.h"
@@ -613,7 +616,11 @@ void PocketLettersMenu::mainAct05() {
             }
         }
     } else {
+#ifdef ENHANCED_PORT
+        if ((gPad[1] & port_key_pockets()) != 0) {  // (the key that opened the pockets, port_options.h)
