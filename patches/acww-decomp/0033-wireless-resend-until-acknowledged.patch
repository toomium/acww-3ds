+                c->replyCount == 4 || !sMp)
                 return;
+            c->rxSeq = seq;
             int i = (c->replyHead + c->replyCount++) % 4;
             c->reply[i].port = port;
             c->reply[i].length = length;
-            memcpy(c->reply[i].data, p + 10, length);
+            memcpy(c->reply[i].data, p + 14, length);
         }
         break;
     case PK_ALIVE:
@@ -895,6 +932,7 @@
         sMp = 1;
         sSeq = 0;
         sMpInCount = 0;
+        sCurSeq = sRxSeq = 0;
         sMpPeriod = FRAME_CYCLES / (freq ? (freq > 16 ? 16 : freq) : 4);
