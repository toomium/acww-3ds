+// ACWW_FRAMESKIP=<n>: the screens drawn every n + 1 frames (the 3DS's default: 1, every other one; elsewhere and in
+// the enhanced port, N3DS_PORT, 0).
+// The game runs every frame as before - its H-blank work line by line, the geometry engine - only the pictures are
+// skipped; the 3D one is drawn in the frame before the screens' (the 2D renderer shows the last frame's 3D picture)
+// ACWW_FRAMESKIP=auto (or auto<n>): the game keeps its speed where it can: a frame that ends more than a frame behind
+// its time has the next one's pictures left out, at most n in a row (5: with the game's picture every third frame,
+// every second one is still shown). Not the same from run to run: it goes by the real time.
+static int frameskip(void) {
+    static int n = -1;
+    if (n < 0) {
+        const char *e = getenv("ACWW_FRAMESKIP");
+        if (e && !strncmp(e, "auto", 4)) {
+            sSkipMax = e[4] ? atoi(e + 4) : 5;
+            if (sSkipMax < 1) sSkipMax = 1;
+            return n = 0;
+        }
+#if defined(__3DS__) && !defined(N3DS_PORT)
+        n = 1;
+#else
+        n = 0;
+#endif
+        if (getenv("ACWW_FRAMESKIP")) n = atoi(getenv("ACWW_FRAMESKIP"));
+        if (n < 0) n = 0;
+    }
+    return n;
 }
