+static void user_settings(void) {
+    u32 at = (sNvram[0x20] | sNvram[0x21] << 8) * 8;
+    if (at + 0x200 > sNvramSize) return;
+    const u8 *pick = 0;
+    for (int copy = 0; copy < 2; copy++) {
