+    NINJA_FILE = f"build_host_switch{args.suffix}.ninja"
 elif N3DS:
     CXX = f"{DKA}/bin/arm-none-eabi-g++"
     build = Path("build") / f"host3ds{args.suffix}_{args.version}"
@@ -175,7 +191,9 @@ else:
