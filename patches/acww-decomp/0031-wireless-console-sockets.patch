From: acww-3ds <noreply@invalid>
Subject: [PATCH] Wireless: on the consoles, the socket service and the network's broadcast address

wm7.c carries the DS's local wireless in UDP datagrams. On the 3DS and the Switch the socket service has to be
started first (plat_3ds.c / plat_switch.c port_net_start, the first time the game turns its wireless on), and
beacons also go to the network's own broadcast address (port_net_broadcast) besides 255.255.255.255.
---
 modern/host/wm7.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/modern/host/wm7.c b/modern/host/wm7.c
--- a/modern/host/wm7.c
+++ b/modern/host/wm7.c
@@ -53,6 +53,10 @@
 #include "nitro/wm.h"
 
 int pxi7_send_pointer(u32 tag, void *p);
+#if defined(__3DS__) || defined(__SWITCH__)
+int port_net_start(void);      // plat_3ds.c / plat_switch.c: the console's socket service, started on first use (0: none)
+u32 port_net_broadcast(void);  // the console's Wi-Fi network's own broadcast address (network order; 0: none)
+#endif
 
 #define MS(n) ((u64)(n) * 33514u)  // virtual cycles (the ARM9 bus clock, 33.514 MHz)
 #define FRAME_CYCLES (2130u * 263u)
@@ -200,6 +204,9 @@
     static int started;
     if (!started) { WSADATA d; if (WSAStartup(MAKEWORD(2, 2), &d)) return; started = 1; }
 #endif
+#if defined(__3DS__) || defined(__SWITCH__)
+    if (!port_net_start()) return;  // (the reason is in the log)
+#endif
     sSock = socket(AF_INET, SOCK_DGRAM, 0);
     if (sSock == BAD_SOCK) { fprintf(stderr, "wm7: no UDP socket: no wireless\n"); return; }
     int one = 1;
@@ -281,6 +288,10 @@
         send_to(&a, length);
         a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
         send_to(&a, length);
+#if defined(__3DS__) || defined(__SWITCH__)  // (and the network's own: a console's 255.255.255.255 doesn't reach every network)
+        u32 b = port_net_broadcast();
+        if (b && b != htonl(INADDR_BROADCAST)) a.sin_addr.s_addr = b, send_to(&a, length);
+#endif
     }
     for (int i = 0; i < sPeerCount; i++) send_to(&sPeers[i], length);
     u64 now = host_plat_time_ns();
