From: acww-3ds <noreply@invalid>
Subject: [PATCH] Player: "New Leaf controls" swap tools with the D-pad's left
 and right

From AC:WW+ (github.com/migueliranzo/acww-plus, MIT), where L and R do it; here the D-pad's left and right, as part of
"New Leaf controls" (ACWW_NL_CONTROLS). While the local player stands and the pockets could open, right takes the next
tool from the pockets into the hand (the hand's into its pocket), left puts the tool away, or with empty hands takes
the last one out again (modern/port/tool_swap.cpp: PlayerActor::waitCheckInput). The equip is the pocket menu's own
request; its "item chosen" pose (Unk_02007694::mainAct05) goes back to standing, as there is no menu to close.

The game's keys don't tell the D-pad from the circle pad or the stick, so the backends give the D-pad's own
directions apart (gHostDpad, include/host_input.h: frontend_3ds.c, frontend_sdl.c), frontend.c keeps a tap for 20
frames (one made during the equip's animation), and PlayerActor::readInput doesn't walk on the D-pad's left and right
while the option is on. The circle pad and the stick walk as before; the D-pad's up and down too. A tap made while a menu or a talk is open is dropped
(MenuManager::onExecute), so it doesn't swap once the menu has closed. ACWW_KEYS' directions count as the D-pad's.
---
 modern/host/frontend.c          | 24 ++++++++++++++++++++++++
 modern/host/frontend_sdl.c      |  8 ++++++++
 src/main/unk_02004558.cpp       | 12 ++++++++++++
 src/main/unk_02004558_extra.cpp |  5 +++++
 src/main/unk_0206e54c.cpp       |  5 +++++
 5 files changed, 54 insertions(+)

diff --git a/modern/host/frontend.c b/modern/host/frontend.c
index 4f837e4..57b1038 100644
--- a/modern/host/frontend.c
+++ b/modern/host/frontend.c
@@ -9,6 +9,9 @@
 #include <string.h>
 
 #include "frontend.h"
+#ifdef ENHANCED_PORT
+#include "host_input.h"
+#endif
 #include "host.h"
 #include "host_mem.h"
 #include "options_cfg.h"
@@ -28,6 +31,23 @@ AcwwShm *frontend_shm(void) { return sShm; }
 // the circle pad for the game (include/host_input.h): its angle and tilt while it holds a direction down
 volatile short gHostStickAngle;
 volatile unsigned short gHostStickTilt;
+#ifdef ENHANCED_PORT
+volatile unsigned char gHostDpad;
+static unsigned sDpadTap;
+static unsigned long long sDpadTapFrame;
+unsigned host_dpad_tap(void) {
+    unsigned t = host_frame() - sDpadTapFrame < 20 ? sDpadTap : 0;
+    sDpadTap = 0;
+    return t;
+}
+// (once a frame: a left or right newly pressed on the D-pad remembered for host_dpad_tap)
+static void dpad_tap(void) {
+    static unsigned prev;
+    unsigned now = gHostDpad & 0x30 & ~prev;
+    prev = gHostDpad & 0x30;
+    if (now == 0x10 || now == 0x20) sDpadTap = now, sDpadTapFrame = host_frame();
+}
+#endif
 static void stick(const AcwwShm *shm, u32 keys) {
     static int on = -1;
     if (on < 0) on = !getenv("ACWW_ANALOG") || atoi(getenv("ACWW_ANALOG"));
@@ -90,6 +110,10 @@ void frontend_frame(void) {
     u32 sk = scripted_keys();
     keyinput &= (u16)~(sk & 0x3ff);
     xy &= (u16)~(sk & 0x0c00);
+#ifdef ENHANCED_PORT
+    gHostDpad = (unsigned char)((sShm ? gHostDpad : 0) | (sk & 0xf0));  // (a script's directions are the D-pad's)
+    dpad_tap();
+#endif
 #ifdef ENHANCED_PORT
     {
         u32 p = (~keyinput & 0x3ff) | (~xy & 0x0c00), hidden = p & ~opt_keys(p);
