From: acww-3ds export <noreply@invalid>
Subject: [PATCH] Runtime core: hardware registers, OS, SDK hooks, memory, coroutines, VRAM

Changes 9 files of the decompilation for the 3DS port (area: runtime-core).
Made by tools/export_from_fork.py; do not edit by hand.

diff --git a/modern/host/coro.c b/modern/host/coro.c
index 8e0bfdb3..266e63ed 100644
--- a/modern/host/coro.c
+++ b/modern/host/coro.c
@@ -132,6 +132,13 @@ void *host_coro_prepare(void *stack, size_t size, void (*fn)(void *), void *arg)
     sp[1] = (uint64_t)(uintptr_t)arg;       // x20
     sp[11] = (uint64_t)(uintptr_t)host_coro_boot;  // x30
     return sp;
+#elif defined(__arm__)
+    uint32_t *sp = (uint32_t *)top - 26;    // d8-d15 (16 words), r4-r12, lr; sp = top after they are popped
+    memset(sp, 0, 26 * sizeof *sp);
+    sp[16] = (uint32_t)(uintptr_t)fn;       // r4
+    sp[17] = (uint32_t)(uintptr_t)arg;      // r5
+    sp[25] = (uint32_t)(uintptr_t)host_coro_boot;  // lr
+    return sp;
 #else
 #error "coro.c: no stack switch for this CPU yet"
 #endif
diff --git a/modern/host/coro_switch.S b/modern/host/coro_switch.S
index d3e30c99..7d6251b3 100644
--- a/modern/host/coro_switch.S
+++ b/modern/host/coro_switch.S
@@ -4,6 +4,7 @@
 //   x86-64 Windows:  xmm6-xmm15 (160 bytes), the TIB's StackLimit, StackBase and DeallocationStack, r15 r14 r13 r12
 //                    rdi rsi rbx rbp, return address (256 bytes)
 //   arm64:  x19-x28, x29 (fp), x30 (lr), d8-d15
+//   arm (32-bit, AAPCS with VFP): d8-d15, r4-r11, r12 (only to keep the stack 8-byte aligned), lr
 // host_coro_prepare (coro.c) builds the same frame on a new stack with host_coro_boot as the return address and
 // fn / arg in callee-saved registers, which host_coro_boot passes on.
 
@@ -106,6 +107,31 @@ SYM(host_coro_boot):
     blr x19
     brk #0
 
+#elif defined(__arm__)
+
+    .syntax unified
+    .arm
+    .fpu vfp
+
+    .globl SYM(host_coro_switch)
+    .type SYM(host_coro_switch), %function
+SYM(host_coro_switch):
+    push {r4-r12, lr}
+    vpush {d8-d15}
+    str sp, [r0]
+    mov sp, r1
+    vpop {d8-d15}
+    pop {r4-r12, lr}
+    bx lr
+
+// r4 = fn, r5 = arg
+    .globl SYM(host_coro_boot)
+    .type SYM(host_coro_boot), %function
+SYM(host_coro_boot):
+    mov r0, r5
+    blx r4
+    bkpt #0
+
 #elif !(defined(__x86_64__) && defined(_WIN32))
 #error "coro_switch.S: no stack switch for this CPU yet"
 #endif
