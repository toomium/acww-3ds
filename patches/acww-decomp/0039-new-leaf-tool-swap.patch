 #include "host.h"
 #include "plat.h"
@@ -265,6 +268,7 @@ static uint32_t pad_keys(void) {
     // analog walk), its directions from a smaller tilt (as the 3DS's circle pad gives them)
     enum { DEAD = 6000 };
     int sx = 0, sy = 0;
+    unsigned dpad = 0;
 #else
     enum { DEAD = 16000 };
 #endif
@@ -273,6 +277,9 @@ static uint32_t pad_keys(void) {
         SDL_GameController *c = sPads[p];
         if (!c) continue;
         k |= ui_pad_keys(c);
+#ifdef ENHANCED_PORT
+        dpad |= ui_pad_keys(c) & 0xf0;  // (the D-pad alone, without the stick: host_input.h)
+#endif
         int x = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTX), y = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTY);
 #ifdef ENHANCED_PORT
         if (x * x + y * y > sx * sx + sy * sy) sx = x, sy = y;  // (of several controllers the one tilted most)
@@ -288,6 +295,7 @@ static uint32_t pad_keys(void) {
     }
 #ifdef ENHANCED_PORT
     sShm->stick_x = (int16_t)(sx * 156 / 32767), sShm->stick_y = (int16_t)(-sy * 156 / 32767);
+    gHostDpad = (unsigned char)dpad;
 #endif
     return k;
 }
