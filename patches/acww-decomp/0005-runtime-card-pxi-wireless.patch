+        if (fw_crc16(0xffff, u, 0x70) != (u16)(u[0x72] | u[0x73] << 8)) continue;
+        if (!pick || ((u[0x70] - pick[0x70]) & 0x7f) == 1) pick = u;  // (the update counter, mod 0x80)
+    }
+    if (pick) memcpy(gHostSysWork.nvramUserInfo, pick, 0x70);
