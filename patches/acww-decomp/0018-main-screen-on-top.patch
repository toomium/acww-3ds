+int n3ds_main_top(void);  // options_3ds.c
+static int sMainTopForced;
+int gpu2d_main_top_forced(void) { return sMainTopForced; }
+#endif
+static int top_engine(void) {
+    int top = (sPowCnt & 0x8000) ? 0 : 1;
+#ifdef N3DS_PORT
+    sMainTopForced = top == 1 && n3ds_main_top() && (reg32(&sEngine[0], REG_DISPCNT) & 8);
+    if (sMainTopForced) top = 0;
+#endif
+    return top;
